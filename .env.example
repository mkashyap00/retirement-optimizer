# ── Backend environment variables ────────────────────────────────────────────

# Optional feature: LLM-enhanced report narrative ("Generate AI summary"
# button; the result is stored with the run and appears as an "Advisor
# Commentary" section in the PDF).
#
# Option A — Anthropic API (install first: pip install -e ".[llm]")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5

# Option B — any local OpenAI-compatible server (llama.cpp, LM Studio,
# Ollama, vLLM). When LLM_BASE_URL is set it takes precedence over
# Anthropic and needs no extra package. Example for llama.cpp server:
#LLM_BASE_URL=http://localhost:8080/v1
#LLM_API_KEY=local
#LLM_MODEL=gemma-4-E4B-it-Q8_0.gguf

# Optional: replace the built-in system prompt with your own persona
# (an advisor-style starting point ships at docs/prompts/advisor.md).
#LLM_SYSTEM_PROMPT_FILE=docs/prompts/advisor.md

# ── Frontend environment variables ───────────────────────────────────────────

# Base URL for the backend API, consumed by the Next.js frontend.
# Override this when running the frontend on a different host or port
# (e.g. in production or inside Docker).
# Default (used when this variable is absent): http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
